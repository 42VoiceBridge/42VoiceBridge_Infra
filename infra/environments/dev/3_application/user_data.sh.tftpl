#!/bin/bash
dnf update -y
dnf install -y docker jq curl
systemctl enable docker
systemctl start docker
systemctl enable --now amazon-ssm-agent
usermod -aG docker ec2-user

%{ if data_device != "" ~}
# --- 영구 데이터 볼륨(/data) ---
# 로그는 /var/log/voicebridge-data-volume.log. 실패해도 위의 Docker/SSM 설치는 이미 끝난
# 상태이며, 배포 스크립트가 /data 마운트 여부를 확인하고 미마운트 시 AI 배포를 거부한다.
exec 3>&1 4>&2
exec >>/var/log/voicebridge-data-volume.log 2>&1

mount_data_volume() {
  local device="${data_device}"
  local mount_point=/data
  local rc=0 uuid

  # volume_attachment는 인스턴스 생성 이후에 만들어지므로 장치가 나타날 때까지 기다린다.
  for _ in $(seq 1 60); do
    [[ -b "$device" ]] && break
    sleep 5
  done
  if [[ ! -b "$device" ]]; then
    echo "Data volume device did not appear: $device" >&2
    return 1
  fi

  # 포맷은 어떤 시그니처(파일시스템, 파티션 테이블)도 없을 때만 한다.
  # blkid -p 종료 코드 2는 "식별 가능한 시그니처 없음"이고, 그 외 오류에서는 절대 포맷하지 않는다.
  blkid -p "$device" >/dev/null 2>&1 || rc=$?
  case "$rc" in
    0) echo "Existing signature found on $device; skipping format." ;;
    2) echo "Blank volume; creating xfs filesystem."
       mkfs -t xfs -L voicebridge-data "$device" ;;
    *) echo "blkid failed (exit $rc) on $device; refusing to format." >&2
       return 1 ;;
  esac

  uuid=$(blkid -o value -s UUID "$device")
  [[ -n "$uuid" ]] || { echo "No filesystem UUID on $device." >&2; return 1; }

  mkdir -p "$mount_point"
  # nofail: 볼륨이 없어도 부팅이 막히지 않게 한다. UUID 기준이라 장치 이름이 바뀌어도 안전하다.
  grep -q "^UUID=$uuid " /etc/fstab || \
    echo "UUID=$uuid $mount_point xfs defaults,nofail 0 2" >>/etc/fstab
  mountpoint -q "$mount_point" || mount "$mount_point"

  mkdir -p "$mount_point/ai/hf" "$mount_point/ai/adapters" "$mount_point/ai/enroll" "$mount_point/ai/jobs"
}

mount_data_volume || echo "Data volume setup FAILED; see messages above." >&2
exec 1>&3 2>&4
%{ endif ~}
